# Copy to .env and fill in. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
# SQLite by default. For PostgreSQL: postgres://user:password@localhost:5432/obligation_desk
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
PRIVATE_MEDIA_ROOT=private_media
MAX_UPLOAD_MB=25
SESSION_IDLE_HOURS=8
SITE_URL=http://localhost:8000
# Password given to every demo user by seed_demo. Leave empty for a random one.
DEMO_PASSWORD=

# Email (production only; development always uses the console backend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Obligation Desk <no-reply@example.org>

# Production file serving through nginx X-Accel-Redirect
USE_X_ACCEL_REDIRECT=False
X_ACCEL_PREFIX=/protected/

# Optional ClamAV scan on upload (requires clamdscan on PATH)
CLAMAV_ENABLED=False
STRIP_IMAGE_EXIF=True
